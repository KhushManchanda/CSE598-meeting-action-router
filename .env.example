# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM ---
# Spec's default was ANTHROPIC_API_KEY; switched to OpenAI at the user's
# request. Put your real key in .env (never here, never in chat) —
# .env is gitignored.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Composio (step 7, live mode only: real Google Calendar/Gmail/Trello) ---
# Replaces a from-scratch Google OAuth flow + raw Trello REST calls,
# at the user's request mid-project. See
# agent/tools/composio_client.py for how this is used, and
# scripts/composio_connect.py for one-time account setup (requires a
# human to approve a browser consent screen per toolkit).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=meeting-action-router

# A real Trello list id from your test board (open the board, "..." on
# a list -> Copy Link, the id is the part after /b/.../ -- or use
# Trello's own API to list a board's lists). Mock mode ignores this.
TRELLO_LIST_ID=
