# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM ---
# Spec's default was ANTHROPIC_API_KEY; switched to OpenAI at the user's
# request. Put your real key in .env (never here, never in chat) —
# .env is gitignored.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Google Calendar / Gmail OAuth (step 7, live mode only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=.secrets/google_token.json

# --- Trello (step 7, live mode only) ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
